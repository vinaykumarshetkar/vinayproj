
name: Maven Build and Docker Push to ACR

# Trigger configuration
on:
  workflow_dispatch:

  # Uncomment to trigger on every push
  # push:
  #   branches:
  #     - main

jobs:

  # Stage 1: Build Maven application
  build:
    name: Build Maven Application
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
          cache: maven

      - name: Build Maven Application
        run: |
          mvn clean package -Dmaven.test.skip=true

      - name: Upload Maven Artifact
        uses: actions/upload-artifact@v4
        with:
          name: drop
          path: '**/target/*.jar'
          if-no-files-found: error


  # Stage 2: Build Docker Image
  docker-build:
    name: Build Docker Image
    runs-on: ubuntu-latest
    needs: build

    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Download Maven Artifact
        uses: actions/download-artifact@v4
        with:
          name: drop
          path: ./drop

      - name: Verify Downloaded JAR
        run: |
          echo "Downloaded artifacts:"
          ls -lh ./drop

      - name: Copy JAR into Docker Build Context
        run: |
          cp ./drop/*.jar .

      - name: Build Docker Image
        run: |
          docker build \
            -t vinayproj:${{ github.run_number }} \
            -t vinayproj:latest \
            -f Dockerfile .

      - name: Verify Docker Image
        run: |
          docker images vinayproj


  # Stage 3: Build Multi-Architecture Image and Push to ACR
  push-to-acr:
    name: Push Multi-Architecture Image to ACR
    runs-on: ubuntu-latest
    needs: docker-build

    permissions:
      contents: read
      id-token: write

    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Download Maven Artifact
        uses: actions/download-artifact@v4
        with:
          name: drop
          path: ./drop

      - name: Copy JAR into Docker Build Context
        run: |
          cp ./drop/*.jar .

      - name: Azure Login
        uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Login to Azure Container Registry
        run: |
          az acr login --name aks3vinayproj

      - name: Setup Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build and Push AMD64 and ARM64 Images
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile
          platforms: linux/amd64,linux/arm64
          push: true
          provenance: false
          sbom: false
          tags: |
            aks3vinayproj.azurecr.io/vinayproj:${{ github.run_number }}
            aks3vinayproj.azurecr.io/vinayproj:latest
